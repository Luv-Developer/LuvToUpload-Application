<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuvToUpload - Home</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel = "stylesheet" type = "text/css" href = "/stylesheets/homepage.css">
</head>
<body>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    
    <div class="container">
        <div class="header">
            <div class="logo">
                <h1>Luv<span>ToUpload</span></h1>
            </div>
            
            <div class="nav-buttons">
                <button class="nav-btn" id="registerBtn">
                    <a href = "/register">
                    <i class="fas fa-user-plus"></i> Register
                    </a>
                </button>
                <button class="nav-btn" id="loginBtn">
                    <a href = "/login">
                    <i class="fas fa-sign-in-alt"></i> Login
                    </a>
                </button>
                <button class="nav-btn" id="profileBtn">
                    <a href = "/profile">
                    <i class="fas fa-user"></i> Profile
                    </a>
                </button>
                <button class="nav-btn" id="uploadBtn">
                    <a href = "/upload">
                    <i class="fas fa-cloud-upload-alt"></i> Upload
                    </a>
                </button>
            </div>
        </div>
        
        <div class="hero">
            <div class="hero-content">
                <h2>Share Your World Through Visual Stories</h2>
                <p>LuvToUpload is the ultimate platform for visual storytellers. Upload, share, and discover amazing content from creators around the world. Join our community of passionate visual artists today!</p>
                <div class="cta-buttons">
                    <button class="nav-btn" id="heroRegisterBtn">
                        <a href = "/upload">
                        <i class="fas fa-rocket"></i> Get Started
                        </a>
                    </button>
                    <button class="nav-btn" id="heroLoginBtn">
                        <a href = "#">
                        <i class="fas fa-play-circle"></i> See How It Works
                        </a>
                    </button>
                </div>
            </div>
            <div class="hero-image">
                <div class="image-placeholder">
                    <i class="fas fa-images"></i>
                    <p>Visualize your creativity with LuvToUpload's intuitive platform</p>
                </div>
            </div>
        </div>
        
        <div class="features">
            <h2 class="section-title">Why Choose LuvToUpload?</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <h3>Lightning Fast Uploads</h3>
                    <p>Upload your high-quality images and videos in seconds with our optimized upload system.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3>Vibrant Community</h3>
                    <p>Connect with creators worldwide, share feedback, and grow together in our supportive community.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>Advanced Analytics</h3>
                    <p>Track your content performance with detailed insights and audience engagement metrics.</p>
                </div>
            </div>
        </div>
        
        <div class="stats">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">500K+</div>
                    <div class="stat-label">Active Users</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">2M+</div>
                    <div class="stat-label">Uploads</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">150+</div>
                    <div class="stat-label">Countries</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">99.9%</div>
                    <div class="stat-label">Uptime</div>
                </div>
            </div>
        </div>
        
        <div class="cta">
            <h2>Ready to Start Your Visual Journey?</h2>
            <p>Join thousands of creators who are already sharing their stories with the world. Sign up now and get 1GB of free storage!</p>
            <div class="cta-buttons">
                <button class="nav-btn" id="ctaRegisterBtn">
                    <a href = "/register">
                    <i class="fas fa-user-plus"></i> Create Account
                    </a>
                </button>
                <button class="nav-btn" id="ctaLoginBtn">
                    <a href = "/login">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                    </a>
                </button>
            </div>
        </div>
        
        <div class="footer">
            <p>&copy; 2025 LuvToUpload. All rights reserved. | Share Your Visual Stories With The World</p>
        </div>
    </div>
    <script src = "/javascripts/homepage.js"></script>
</body>
</html>