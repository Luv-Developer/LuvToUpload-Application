<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuvToUpload - Reset Password</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel = "stylesheet" type = "text/css" href = "/stylesheets/forgot.css">
</head>
<body>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    
    <div class="container">
        <div class="logo">
            <h1>Luv<span>ToUpload</span></h1>
        </div>
        
        <div class="card">
            <h2>Reset Your Password</h2>
            <p>Enter your email address and we'll send you a link to reset your password.</p>
            
            <form action = "/forgot" method = "post" id="forgotForm">
                <div class="input-group">
                    <input type="email" name = "email" id="email" placeholder="Enter your email address" required>
                    <i class="fas fa-envelope"></i>
                </div>
                
                <button type="submit" class="btn">Send Reset Link</button>
            </form>
            
            <div class="success-message" id="successMessage">
                <i class="fas fa-paper-plane"></i>
                <p>Password has been sent to the email</p>
            </div>
            
            <div class="back-link">
                <a href="/login"><i class="fas fa-arrow-left"></i> Back to Login</a>
            </div>
        </div>
    </div>
    <script src = "/javascripts/forgot.js"></script>
</body>
</html>